# Copy to .env (never commit .env).

# Default (unset): SQLite at backend/data/charting.db. For Postgres/TimescaleDB:
# DATABASE_URL=postgresql+psycopg://charting:charting@localhost:5432/charting

# Market data source: "synthetic" (no key needed), "kite", or "eod" (local daily CSVs,
# imported with `python -m app.cli import-eod`; live ticks are simulated and never saved)
DATA_SOURCE=synthetic
# EOD_DIR=C:\path\to\market_data_daily        # folder holding <EXCHANGE>/bhavcopy_adjusted/*.csv
# EOD_HOURLY_DIR=C:\path\to\market_data_hourly  # optional: <EXCHANGE>/<EXCHANGE>_YYYYMMDD_HHMM.csv (1h bars)
# EOD_EXCHANGES=["NSE"]                        # also BSE, NASDAQ, NYSE

# Live data. Empty REDIS_URL = in-process memory store.
# REDIS_URL=redis://localhost:6379/0
# LIVE_ENABLED=true
# WS_THROTTLE_MS=250

# AI analyst (Claude). Leave empty to use the SDK's default credential resolution.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# Zerodha Kite Connect: private prototyping ONLY, data may not be redistributed.
KITE_API_KEY=
KITE_API_SECRET=
# Regenerated daily: python -m app.cli kite-login
KITE_ACCESS_TOKEN=
